# Configuration publique du site ADFR (aucun secret ici)
REACT_APP_BRAND=adfr
REACT_APP_SITE_URL=https://adfr-depannage.fr
REACT_APP_BACKEND_URL=https://adfr-api.onrender.com
# Appels API par le même domaine que le site (voir vercel.json) : nécessaire pour la connexion admin sur iPhone
REACT_APP_API_PATH=/api
